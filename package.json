{
  "name": "lumen",
  "version": "1.0.2",
  "private": true,
  "description": "A cozy, offline-first PDF reading desk with a private local AI that answers questions about your books.",
  "author": "Nihal J",
  "license": "MIT",
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.7",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^7.7.3",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "react-scripts build && electron-builder",
    "build:full": "cross-env REACT_APP_EDITION=full react-scripts build",
    "build:lite": "cross-env REACT_APP_EDITION=lite react-scripts build && node scripts/strip-lite-assets.js",
    "dist": "npm run dist:full",
    "dist:full": "npm run build:full && electron-builder -c.artifactName=${productName}-${version}-full-${os}-${arch}.${ext}",
    "dist:lite": "npm run build:lite && electron-builder -c.artifactName=${productName}-${version}-lite-${os}-${arch}.${ext}",
    "dist:all": "npm run dist:full && npm run dist:lite"
  },
  "build": {
    "extends": null,
    "appId": "com.lumen.reader",
    "productName": "Lumen",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!rag-data/**",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lumen",
      "uninstallDisplayName": "Lumen"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Nihal J",
      "synopsis": "Cozy offline PDF reader with a private local AI",
      "desktop": {
        "Name": "Lumen",
        "Comment": "Read PDFs and chat with your books, fully offline"
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
